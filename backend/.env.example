# Optional PostgreSQL Compose setup; use long random values, with a URL-safe DB password.
# docker compose --env-file backend/.env up --build
FCM_DB_PASSWORD=
FCM_SECRET_KEY=
FCM_ADMIN_TOKEN=
# Local management password defaults to 123456; FCM_ADMIN_TOKEN may override it.
# Local Conda defaults use SQLite and backend/runtime/dev-secrets.json.
# To select an existing PostgreSQL server, export FCM_DATABASE_URL=postgresql+psycopg://...
