{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fcm.local/contracts/development-codes.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "development_only": {
      "const": true
    },
    "study_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "codes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "minItems": 0
      }
    }
  },
  "required": [
    "schema_version",
    "development_only",
    "study_id",
    "codes"
  ],
  "additionalProperties": false
}
