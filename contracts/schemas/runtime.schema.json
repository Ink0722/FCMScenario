{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fcm.local/contracts/runtime.schema.json",
  "title": "Participant-facing data transfer objects",
  "$ref": "#/$defs/MaterialBundle",
  "$defs": {
    "Choice": {
      "type": "string",
      "enum": [
        "A",
        "B"
      ]
    },
    "Question": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "title",
        "required",
        "options"
      ],
      "additionalProperties": false
    },
    "Scenario": {
      "type": "object",
      "properties": {
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "scenario_id": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "template": {
          "type": "string",
          "enum": [
            "table",
            "cards"
          ]
        },
        "background": {
          "type": "string",
          "minLength": 1
        },
        "common_facts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "comparison": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "attribute": {
                "type": "string",
                "minLength": 1
              },
              "A": {
                "type": "string",
                "minLength": 1
              },
              "B": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "attribute",
              "A",
              "B"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "additional_information": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "terms",
                  "survey",
                  "history"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "title",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "document_id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "revision": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "document_id",
              "title",
              "url",
              "revision"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "task": {
          "type": "string",
          "minLength": 1
        },
        "knowledge": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "title",
              "text"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/Choice"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "case_id",
        "scenario_id",
        "title",
        "template",
        "background",
        "common_facts",
        "comparison",
        "additional_information",
        "references",
        "task",
        "knowledge",
        "options",
        "revision"
      ],
      "additionalProperties": false
    },
    "SharedCopy": {
      "type": "object",
      "properties": {
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "welcome": {
          "type": "string"
        },
        "choice_prompt": {
          "type": "string"
        },
        "confidence_prompt": {
          "type": "string"
        },
        "confidence_scale": {
          "type": "string"
        },
        "pre_prompt": {
          "type": "string"
        },
        "probe_prompt": {
          "type": "string"
        },
        "post_prompt": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "welcome",
        "choice_prompt",
        "confidence_prompt",
        "confidence_scale",
        "pre_prompt",
        "probe_prompt",
        "post_prompt",
        "revision"
      ],
      "additionalProperties": false
    },
    "Decision": {
      "type": "object",
      "properties": {
        "choice": {
          "$ref": "#/$defs/Choice"
        },
        "confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "choice",
        "confidence"
      ],
      "additionalProperties": false
    },
    "DecisionStage": {
      "type": "string",
      "enum": [
        "pre",
        "probe",
        "post"
      ]
    },
    "Message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "assistant",
            "user"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "role",
        "text",
        "timestamp"
      ],
      "additionalProperties": false
    },
    "DialoguePolicy": {
      "type": "object",
      "properties": {
        "canEnd": {
          "type": "boolean"
        },
        "probeRequired": {
          "type": "boolean"
        }
      },
      "required": [
        "canEnd",
        "probeRequired"
      ],
      "additionalProperties": false
    },
    "ExperimentStage": {
      "type": "string",
      "enum": [
        "pre",
        "dialogue",
        "post",
        "finishing",
        "complete"
      ]
    },
    "TestTask": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "number": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "available",
            "in_progress",
            "completed",
            "unavailable"
          ]
        }
      },
      "required": [
        "id",
        "number",
        "title",
        "status"
      ],
      "additionalProperties": false
    },
    "AccessGrant": {
      "type": "object",
      "properties": {
        "accessToken": {
          "type": "string",
          "minLength": 1
        },
        "expiresAt": {
          "type": "string",
          "minLength": 1
        },
        "testCode": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "accessToken",
        "expiresAt",
        "testCode"
      ],
      "additionalProperties": false
    },
    "ExperimentInstructions": {
      "type": "object",
      "properties": {
        "welcome": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "welcome",
        "revision"
      ],
      "additionalProperties": false
    },
    "ParticipantProfile": {
      "type": "object",
      "properties": {
        "questions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Question"
          },
          "minItems": 0
        },
        "answers": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "questions",
        "answers"
      ],
      "additionalProperties": false
    },
    "SessionProgress": {
      "type": "object",
      "properties": {
        "stage": {
          "$ref": "#/$defs/ExperimentStage"
        },
        "dialogueStatus": {
          "type": "string",
          "enum": [
            "ready",
            "probe"
          ]
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Message"
          },
          "minItems": 0
        },
        "decisions": {
          "type": "object",
          "properties": {
            "pre": {
              "$ref": "#/$defs/Decision"
            },
            "probe": {
              "$ref": "#/$defs/Decision"
            },
            "post": {
              "$ref": "#/$defs/Decision"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "receipt": {
          "type": "string"
        }
      },
      "required": [
        "stage",
        "dialogueStatus",
        "messages",
        "decisions",
        "receipt"
      ],
      "additionalProperties": false
    },
    "StartedTask": {
      "type": "object",
      "properties": {
        "task": {
          "$ref": "#/$defs/TestTask"
        },
        "session": {
          "$ref": "#/$defs/Session"
        },
        "scenario": {
          "$ref": "#/$defs/Scenario"
        },
        "shared": {
          "$ref": "#/$defs/SharedCopy"
        },
        "bundleRevision": {
          "type": "string",
          "minLength": 1
        },
        "progress": {
          "$ref": "#/$defs/SessionProgress"
        }
      },
      "required": [
        "task",
        "session",
        "scenario",
        "shared",
        "bundleRevision",
        "progress"
      ],
      "additionalProperties": false
    },
    "Session": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "taskNumber": {
          "type": "string",
          "minLength": 1
        },
        "scenarioRevision": {
          "type": "string",
          "minLength": 1
        },
        "sharedRevision": {
          "type": "string",
          "minLength": 1
        },
        "uiVersion": {
          "type": "string",
          "minLength": 1
        },
        "uiLocale": {
          "type": "string",
          "minLength": 1
        },
        "initialMessage": {
          "$ref": "#/$defs/Message"
        },
        "policy": {
          "$ref": "#/$defs/DialoguePolicy"
        }
      },
      "required": [
        "id",
        "taskId",
        "taskNumber",
        "scenarioRevision",
        "sharedRevision",
        "uiVersion",
        "initialMessage",
        "policy"
      ],
      "additionalProperties": false
    },
    "ExperimentEvent": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "stage_view",
            "reference_open",
            "information_toggle",
            "dialogue_end"
          ]
        },
        "details": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      },
      "required": [
        "id",
        "timestamp",
        "kind",
        "details"
      ],
      "additionalProperties": false
    },
    "DecisionSubmission": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "$ref": "#/$defs/DecisionStage"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "timestamp": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "requestId",
        "stage",
        "decision",
        "timestamp"
      ],
      "additionalProperties": false
    },
    "MaterialBundle": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "minLength": 1
        },
        "bundle_revision": {
          "type": "string",
          "minLength": 1
        },
        "shared": {
          "$ref": "#/$defs/SharedCopy"
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Scenario"
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "bundle_revision",
        "shared",
        "scenarios"
      ],
      "additionalProperties": false
    }
  }
}
