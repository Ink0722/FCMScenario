{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fcm.local/contracts/study.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "study_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "case_locale": {
      "type": "string",
      "minLength": 1
    },
    "shared_copy": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "object",
      "properties": {
        "min_turns_before_end": {
          "type": "integer",
          "minimum": 1
        },
        "probe_after_turns": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "min_turns_before_end",
        "probe_after_turns"
      ],
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
          },
          "number": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
          },
          "case_id": {
            "type": "string",
            "pattern": "^[0-9]{2,}$"
          },
          "probe_enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "number",
          "case_id",
          "probe_enabled"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "development_codes": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "study_id",
    "case_locale",
    "shared_copy",
    "profile",
    "policy",
    "tasks"
  ],
  "additionalProperties": false
}
