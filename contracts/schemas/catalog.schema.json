{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fcm.local/contracts/catalog.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "default_locale": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[0-9]{2,}$"
          },
          "folder": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
          },
          "scenario_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
          },
          "locales": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1
                },
                "legacy_mode": {
                  "type": "string",
                  "enum": [
                    "verify",
                    "none"
                  ]
                }
              },
              "required": [
                "file",
                "legacy_mode"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "case_id",
          "folder",
          "scenario_id",
          "locales"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "default_locale",
    "cases"
  ],
  "additionalProperties": false
}
