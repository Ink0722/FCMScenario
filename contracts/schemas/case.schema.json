{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fcm.local/contracts/case.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0",
      "type": "string"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[0-9]{2,}$"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "locale": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "template": {
      "type": "string",
      "enum": [
        "table",
        "cards"
      ]
    },
    "background": {
      "type": "string",
      "minLength": 1
    },
    "common_facts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "A",
              "B"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "label"
        ],
        "additionalProperties": false
      },
      "minItems": 2,
      "maxItems": 2
    },
    "comparison": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
          },
          "attribute": {
            "type": "string",
            "minLength": 1
          },
          "values": {
            "type": "object",
            "properties": {
              "A": {
                "type": "string",
                "minLength": 1
              },
              "B": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "A",
              "B"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "attribute",
          "values"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "additional_information": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "terms",
              "survey",
              "history"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "document_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "document_id",
          "title",
          "file"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "knowledge": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "legacy_source": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "file",
        "sha256",
        "payload_sha256"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "scenario_id",
    "locale",
    "title",
    "template",
    "background",
    "common_facts",
    "options",
    "comparison",
    "additional_information",
    "references",
    "task",
    "knowledge"
  ],
  "additionalProperties": false
}
